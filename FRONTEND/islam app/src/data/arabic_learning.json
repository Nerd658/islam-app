  "tajweedRules": [
    {
      "id": 1,
      "name": "Madd (Élongation)",
      "color": "rose",
      "hex": "#f43f5e",
      "description": "L'élongation de la voyelle longue (Alif, Waw, Ya) de 2, 4, 5 ou 6 temps selon le type de Madd.",
      "example": "جَآءَ / ٱلرَّحْمَٰنِ"
    },
    {
      "id": 2,
      "name": "Ghunna (Nasalisation)",
      "color": "emerald",
      "hex": "#10b981",
      "description": "Le son nasal provenant du nez d'une durée de 2 temps sur le Nun (نّ) ou Mim (مّ) shaddah.",
      "example": "إِنَّ / ثُمَّ"
    },
    {
      "id": 3,
      "name": "Qalqala (Rebond)",
      "color": "blue",
      "hex": "#3b82f6",
      "description": "Le rebond sonore provoqué par l'arrêt sur l'une des 5 lettres de Qalqala (ق, ط, ب, ج, د) lorsqu'elles portent un sukun.",
      "example": "قُلْ هُوَ ٱللَّهُ أَحَدٌ (د)"
    },
    {
      "id": 4,
      "name": "Ikhfa (Dissimulation)",
      "color": "orange",
      "hex": "#f97316",
      "description": "La dissimulation partielle du Nun sakin (نْ) ou Tanween devant l'une des 15 lettres d'Ikhfa avec Ghunna.",
      "example": "مِن قَبْلُ / كِتَٰبٌ كَرِيمٌ"
    },
    {
      "id": 5,
      "name": "Idgham (Fusion)",
      "color": "purple",
      "hex": "#a855f7",
      "description": "La fusion du Nun sakin (نْ) ou Tanween dans la lettre suivante (ي, ر, م, ل, و, ن).",
      "example": "مَن يَقُولُ / مِن رَّبِّهِمْ"
    },
    {
      "id": 6,
      "name": "Iqlab (Conversion)",
      "color": "cyan",
      "hex": "#06b6d4",
      "description": "La conversion du Nun sakin (نْ) ou Tanween en un Mim (م) devant la lettre Ba (ب) avec Ghunna.",
      "example": "مِن بَعْدِ"
    }
  ],
  "grammar": [
    {
      "id": 1,
      "title": "Le Nom (أَلاِسْمُ - Al-Ism)",
      "definition": "Désigne une personne, un objet, un endroit ou une qualité sans notion de temps.",
      "characteristics": "Peut porter l'article défini (الْـ), le Tanween (ـٌ ـٍ ـً) ou un cas sujet/objet.",
      "exampleArabic": "الْكِتَابُ / رَجُلٌ",
      "exampleFr": "Le livre / Un homme"
    },
    {
      "id": 2,
      "title": "Le Verbe (َالْفِعْلُ - Al-Fi'l)",
      "definition": "Indique une action accomplie liée à un temps (passé, présent/futur, ou impératif).",
      "characteristics": "Se conjugue selon le pronom (Passé: Madi, Présent: Mudari', Ordre: Amr).",
      "exampleArabic": "قَالَ / يَعْلَمُونَ",
      "exampleFr": "Il a dit / Ils savent"
    },
    {
      "id": 3,
      "title": "La Particule (َالْحَرْفُ - Al-Harf)",
      "definition": "Un mot qui n'a de sens complet que lorsqu'il est relié à un nom ou à un verbe.",
      "characteristics": "Comprend les prépositions (مِنْ, إِلَى, فِي, عَلَى) et les conjonctions (وَ, فـ, ثُمَّ).",
      "exampleArabic": "فِي / مِن / عَلَى",
      "exampleFr": "Dans / De / Sur"
    }
  ]
}
