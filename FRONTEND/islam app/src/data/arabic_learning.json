  "confusedPairs": [
    { "id": 1, "l1": "تَاء", "name1": "Ta (Doux)", "l2": "طَاء", "name2": "Ta (Emphatique Lourd)", "diff": "Le ت (Ta'a) est un T fin et léger, alors que le ط (Ta'a lourd) est emphatique produit en creusant la langue." },
    { "id": 2, "l1": "سِين", "name1": "Sin (Sifflement)", "l2": "صَاد", "name2": "Sad (Emphatique)", "diff": "Le س (Sin) est un S clair et aigu, le ص (Sad) est un S lourd et grave." },
    { "id": 3, "l1": "دَال", "name1": "Dal (Doux)", "l2": "ضَاد", "name2": "Dhad (Emphatique)", "diff": "Le د (Dal) est un D léger, le ض (Dhad) est unique à l'arabe (obtenu en appuyant le côté de la langue sur les molaires)." },
    { "id": 4, "l1": "كَاف", "name1": "Kaf (Léger)", "l2": "قَاف", "name2": "Qaf (Profond)", "diff": "Le ك (Kaf) est prononcé à l'avant du palais comme en français, le ق (Qaf) vient du fond du palais." },
    { "id": 5, "l1": "هَاء", "name1": "Ha (Doux bas de gorge)", "l2": "حَاء", "name2": "Ha (Expiré milieu de gorge)", "diff": "Le هـ (Ha) est un simple souffle doux, le ح (Ha) est un souffle chaud expiré du milieu de la gorge." }
  ],
