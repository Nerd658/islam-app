  "grammar": [
    { "id": 1, "title": "Al-Ism (الاسْم) — Le Nom", "definition": "Mot désignant une personne, un lieu, une chose ou un concept sans notion de temps.", "characteristics": "Accepte l'article AL (ال), le Tanween (ً ٍ ٌ) et la Kasra.", "exampleArabic": "كِتَابٌ / المَسْجِدُ", "exampleFr": "Un livre / La mosquée" },
    { "id": 2, "title": "Al-Fi'l (الفِعْل) — Le Verbe", "definition": "Mot indiquant une action liée à un temps (passé, présent/futur, impératif).", "characteristics": "Se conjugue selon le temps (Madhi, Mudhari, Amr).", "exampleArabic": "كَتَبَ / يَكْتُبُ", "exampleFr": "Il a écrit / Il écrit" },
    { "id": 3, "title": "Al-Harf (الحَرْف) — La Particule", "definition": "Mot qui n'a de sens complet qu'associé à un Nom ou un Verbe.", "characteristics": "Invariable (ex: prépositions, conjonctions).", "exampleArabic": "فِي / مِنْ / عَلَى", "exampleFr": "Dans / De / Sur" }
  ]
}
